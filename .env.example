# Core secrets — never commit real values
TELEGRAM_BOT_TOKEN=

# AES-256-GCM key file for SSH passwords and per-user Qoder credentials.
# It must live OUTSIDE the repo and be backed up separately (0600).
TELEOPS_SECRET_KEY_FILE=./data/teleops.key

# Full https:// URL of the "Connect Qoder" Telegram Mini App, e.g.
# https://teleops.example.com/qoder-key/app . Telegram only accepts a valid
# HTTPS origin; without it /qoderkey falls back to a single-use localhost link.
TELEOPS_MINI_APP_URL=

# Paths (defaults shown; override as needed)
DATABASE_FILE=./data/teleops.db
SESSION_ROOT=./data/sessions
LOG_ROOT=./logs
CONFIG_FILE=./config/config.yaml

NODE_ENV=development
