{
  "name": "teleops",
  "version": "0.1.0",
  "description": "AI Command Center for Telegram — control plane for persistent AI dev sessions, Git, server monitoring, approvals and alerts.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:miniapp": "tsx scripts/check-miniapp.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.27.0",
    "js-yaml": "^4.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.0",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
